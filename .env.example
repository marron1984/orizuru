# ───────────────────────────────────────────────────────────
# ORIZURU ティザーサイト 環境変数サンプル
# このファイルを .env.local にコピーして値を設定してください。
# 値が未設定の場合、寄付ボタンは「準備中」モーダルを表示します。
# ───────────────────────────────────────────────────────────

# 寄付（ドネーション）の外部遷移先 URL（任意）。
# 外部の寄付ページ（公益財団／認定NPO 等）へ飛ばしたい場合のみ設定する。
# 設定すると CTA は内蔵の /donate ではなくこの URL へ遷移する。
# 通常は未設定でよい（内蔵の Stripe 寄付ページを使う）。投資・出資の導線は置かない。
NEXT_PUBLIC_DONATE_URL=

# ─── Stripe（寄付決済） ───────────────────────────────────
# Stripe ダッシュボードの「APIキー」から取得。
# STRIPE_SECRET_KEY が未設定の場合、/donate は「準備中」表示にフォールバックする
#（寄付の受け皿となる公益財団／認定NPO の口座・規約が固まってから設定する運用）。
STRIPE_SECRET_KEY=

# Webhook 署名シークレット（任意・本番推奨）。
# `stripe listen` または Dashboard の Webhook 設定で取得。
# checkout.session.completed などの受領確認をサーバーログに記録する。
STRIPE_WEBHOOK_SECRET=

# ─── お知らせ登録（subscribe）の通知先 ───────────────────────
# 登録の届け先メールアドレス。未設定時は既定（lib/notify.ts のティザー運用担当）。
SUBSCRIBE_NOTIFY_EMAIL=yoshida@aska-g.com

# Resend でメール通知する場合のキーと送信元。
# RESEND_API_KEY を設定すると、登録のたびに SUBSCRIBE_NOTIFY_EMAIL へ通知が届く。
# 本番では独自ドメインの検証済み送信元を RESEND_FROM に設定する。
RESEND_API_KEY=
RESEND_FROM=ORIZURU <onboarding@resend.dev>

# 代替: メール登録を任意の Webhook へ転送したい場合（Formspree 等）。
# RESEND_API_KEY が未設定で、これが設定されていれば、こちらへ転送する。
# いずれも未設定なら API はバリデーションを通し、ログ出力のみで成功を返す。
SUBSCRIBE_ENDPOINT=

# 公開サイトの正規 URL（OGP / metadataBase 用）。
NEXT_PUBLIC_SITE_URL=https://orizuru.example.com
